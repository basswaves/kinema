{
  "name": "kinema",
  "version": "0.1.0",
  "description": "A local, serverless media library for movies and TV shows. Tauri 2 + React 19 + libmpv.",
  "license": "MIT",
  "author": "Basswaves",
  "repository": {
    "type": "git",
    "url": "https://github.com/Basswaves/kinema.git"
  },
  "homepage": "https://github.com/Basswaves/kinema",
  "bugs": "https://github.com/Basswaves/kinema/issues",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit && eslint . && vitest run",
    "tauri": "tauri",
    "app:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-app.ps1"
  },
  "dependencies": {
    "@noriginmedia/norigin-spatial-navigation": "^3.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-opener": "^2",
    "guessit-js": "^4.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tauri-plugin-libmpv-api": "^0.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  }
}
