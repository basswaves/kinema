<?xml version="1.0" encoding="utf-8"?>
<!-- Plain HTTP only to this device itself: a film on a network share is read
     by Kinema's core and handed to the player at 127.0.0.1 (stream.rs). Every
     other address stays encrypted-only, as before. A test build has its own
     copy of this file (src/debug), open to its development server. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
