{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "app": {
    "windows": [
      {
        "title": "Kinema",
        "width": 1280,
        "height": 720,
        "minWidth": 854,
        "minHeight": 480,
        "resizable": true,
        "maximized": true,
        "transparent": false,
        "backgroundColor": "#0a0a0c",
        "visible": false,
        "dragDropEnabled": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "category": "Video",
    "shortDescription": "A local, serverless media library for movies and TV shows",
    "longDescription": "Kinema shows the films and series on your own drives and network shares as a library, and plays them with mpv. It runs no server and needs no account. Made for a TV and a remote as much as for a desk.",
    "publisher": "Basswaves",
    "homepage": "https://github.com/basswaves/kinema",
    "license": "MIT",
    "linux": {
      "deb": {
        "desktopTemplate": "linux/kinema.desktop",
        "depends": ["libmpv2"],
        "recommends": ["ffmpeg"],
        "files": {
          "/usr/lib/kinema/libmpv-wrapper.so": "lib/libmpv-wrapper.so",
          "/usr/share/doc/kinema/LICENSE": "../LICENSE",
          "/usr/share/doc/kinema/NOTICE.md": "../NOTICE.md"
        }
      },
      "rpm": {
        "desktopTemplate": "linux/kinema.desktop",
        "depends": ["mpv-libs"],
        "recommends": ["(ffmpeg or ffmpeg-free)"],
        "postRemoveScript": "linux/rpm-postremove.sh",
        "files": {
          "/usr/lib/kinema/libmpv-wrapper.so": "lib/libmpv-wrapper.so",
          "/usr/share/doc/kinema/LICENSE": "../LICENSE",
          "/usr/share/doc/kinema/NOTICE.md": "../NOTICE.md"
        }
      }
    }
  }
}
